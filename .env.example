# Copy to .env and adjust. .env is gitignored; nothing real belongs in this file.
# In production these values come from a SOPS-encrypted Kubernetes secret, never from a file.

# --- Application ---
APP_VERSION=0.1.0-SNAPSHOT
SPRING_PROFILES_ACTIVE=local
LOG_LEVEL_APP=DEBUG

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blueprint
DB_USER=blueprint
DB_PASSWORD=change-me-locally
DB_POOL_MAX=10
DB_POOL_MIN=2

# --- Tracing ---
TRACE_SAMPLE_RATE=1.0
OTLP_ENDPOINT=http://localhost:4318/v1/traces
