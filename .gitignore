# --- Local planning / assistant notes (never committed) ---
PLAN.md
MEMORY.md
.notes/

# --- Environment & secrets ---
.env
.env.*
!.env.example
*.pem
*.key
!**/testdata/*.key
age.key
*.decrypted.yaml
kubeconfig
*.kubeconfig
# Written by the Ansible k3s role; grants cluster-admin.
infra/.kube/

# Generated local secret material. The directory and its README are tracked; the
# secret files themselves never are.
deploy/compose/secrets/**
!deploy/compose/secrets/README.md

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/
*.egg-info/

# --- Java / Gradle ---
.gradle/
build/
*.class
*.jar
!**/gradle/wrapper/gradle-wrapper.jar
out/
bin/

# --- Terraform ---
.terraform/
# .terraform.lock.hcl is deliberately NOT ignored. It is the provider dependency lock -
# the same role gradle/libs.versions.toml plays for Java - and a repository that claims
# every input is pinned cannot leave provider resolution to whatever the registry serves
# today. Generated for linux_amd64, linux_arm64 and darwin_arm64 with
# `terraform providers lock -platform=...`.
*.tfstate
*.tfstate.*
*.tfvars
!example.tfvars
crash.log
tfplan
tfplan.*

# --- Tooling / OS ---
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
node_modules/
*.log
tmp/
