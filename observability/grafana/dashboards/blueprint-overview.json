      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(traefik_router_requests_total{service=~\"$gateway_api\", code=~\"5..\"}[$__rate_interval]))\n  /\nsum(rate(traefik_router_requests_total{service=~\"$gateway_api\"}[$__rate_interval]))",
          "legendFormat": "5xx ratio",
          "range": true,
          "instant": false,
          "exemplar": false
