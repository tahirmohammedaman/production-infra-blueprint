{
  "uid": "blueprint-overview",
  "title": "Blueprint / Overview",
  "description": "Start here. Objectives first, then the gateway, the API, the worker and the logs \u2014 in the order a request meets them.",
  "tags": [
    "blueprint"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "blueprint"
      ],
      "asDropdown": true,
      "title": "Blueprint",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "templating": {
    "list": [
      {
        "type": "constant",
        "name": "gateway_api",
        "label": "Gateway service",
        "hide": 2,
        "query": "api@docker|blueprint-api-.+@kubernetes",
        "skipUrlSync": true,
        "description": "The API's service name as the gateway reports it, in Compose and in the cluster. Same selector as observability/prometheus/rules/slo.yml."
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "changes(process_start_time_seconds{job=~\"api|worker\"}[2m]) > 0",
        "step": "1m",
        "titleFormat": "{{job}} restarted",
        "textFormat": "{{instance}} \u2014 a deploy, a crash or an OOM kill. The logs around this line say which.",
        "useValueForTime": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Objectives \u2014 share of the 30-day error budget left",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "API availability",
      "description": "1 is untouched, 0 is spent, negative is overspent. At zero the objective is missed for this 30-day window and docs/slo.md says what happens next.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:error_budget:remaining_ratio{slo=\"api-availability\"}",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.25
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "no traffic yet",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": {
