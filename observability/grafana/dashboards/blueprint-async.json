{
  "uid": "blueprint-async",
  "title": "Blueprint / Async pipeline",
  "description": "Outbox to Kafka to worker to read model. Every hop, and the three ways an event can fail to arrive: stuck, lagging, dead-lettered.",
  "tags": [
    "blueprint"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "blueprint"
      ],
      "asDropdown": true,
      "title": "Blueprint",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "changes(process_start_time_seconds{job=~\"api|worker\"}[2m]) > 0",
        "step": "1m",
        "titleFormat": "{{job}} restarted",
        "textFormat": "{{instance}} \u2014 a deploy, a crash or an OOM kill. The logs around this line say which.",
        "useValueForTime": false
      }
    ]
  },
  "panels": [
