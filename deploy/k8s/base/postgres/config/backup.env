# Where WAL segments and base backups go, as rclone sees it.
#
# Read through the `postgres-backup` ConfigMap by the Postgres StatefulSet (archiving), the
# postgres-backup CronJob and the postgres-restore Job, and by scripts/restore-drill.sh, which
# replaces the endpoint, region and bucket and nothing else.
#
# Credentials are not here. AWS_SHARED_CREDENTIALS_FILE names a file projected from the
# `postgres-object-storage` Secret, created by hand once per cluster (deploy/k8s/README.md).
BACKUP_REMOTE=archive:blueprint-prod-data
RCLONE_CONFIG_ARCHIVE_TYPE=s3
RCLONE_CONFIG_ARCHIVE_PROVIDER=Other
RCLONE_CONFIG_ARCHIVE_ENDPOINT=https://fsn1.your-objectstorage.com
RCLONE_CONFIG_ARCHIVE_REGION=fsn1
RCLONE_CONFIG_ARCHIVE_ENV_AUTH=true
# The bucket is Terraform's, and exists before anything writes to it. Without this rclone asks
# to create it on every upload, which is one more request per WAL segment and a permission these
# credentials do not need.
RCLONE_CONFIG_ARCHIVE_NO_CHECK_BUCKET=true
AWS_SHARED_CREDENTIALS_FILE=/run/object-storage/credentials
# Empty: no config file. The remote is defined entirely by the variables above, and without this
# rclone looks for one and logs that it is missing on every invocation — once per WAL segment.
RCLONE_CONFIG=
