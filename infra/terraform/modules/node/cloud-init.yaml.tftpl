#cloud-config
# Runs once, before Ansible has ever connected. Its only job is to make the first Ansible
# connection possible and safe; anything that must remain true over the node's life belongs
# in a playbook, which can be re-run and asserted.
hostname: ${hostname}
fqdn: ${hostname}

users:
  - name: ${admin_user}
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - ${admin_ssh_key}

package_update: true
packages:
  # Ansible needs an interpreter on the target. Everything else it installs itself.
  - python3
  - python3-apt

write_files:
  - path: /etc/ssh/sshd_config.d/99-hardening.conf
    permissions: "0644"
    content: |
      # Written here rather than by Ansible because the window between first boot and the
      # first playbook run is exactly when an exposed password prompt matters.
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      X11Forwarding no

runcmd:
  - [ systemctl, restart, ssh ]

# The root account keeps no usable password; access is by key to ${admin_user} only.
disable_root: true
ssh_pwauth: false
