---
import { site } from '../config';
import { withBase } from '../lib/paths';
---

<header class="topbar">
  <button class="icon-button nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false" data-nav-toggle>
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M2 4.5h14M2 9h14M2 13.5h14"></path>
    </svg>
  </button>

  <a class="brand" href={withBase('/')}>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
      <rect x="1.5" y="1.5" width="21" height="21" stroke-width="1.5"></rect>
      <path d="M1.5 9h21M9 1.5v21" stroke-width="1" opacity=".55"></path>
      <path d="M13 13h6.5v6.5" stroke-width="1.5"></path>
      <circle cx="5.25" cy="5.25" r="1.6" fill="currentColor" stroke="none"></circle>
    </svg>
    <span class="brand-name"><span class="long">{site.title}</span><span class="short">Blueprint</span></span>
    <span class="brand-rev">Rev. {site.revision}</span>
  </a>

  <div class="topbar-actions">
    <button class="search-trigger" type="button" data-search-open aria-label="Search the documentation">
      <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="7" cy="7" r="5"></circle>
        <path d="m11 11 3.5 3.5"></path>
      </svg>
      <span class="label">Search the blueprint</span>
      <kbd>/</kbd>
    </button>

    <a class="icon-button" href={site.repo} aria-label="Source on GitHub" rel="noopener">
      <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
      </svg>
    </a>

    <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="Switch between the dark drawing and the light print">
      <svg class="moon" width="17" height="17" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
        <path d="M13.5 9.6A5.8 5.8 0 0 1 6.4 2.5a5.8 5.8 0 1 0 7.1 7.1Z"></path>
      </svg>
      <svg class="sun" width="17" height="17" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
        <circle cx="8" cy="8" r="3"></circle>
        <path d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3 3l1.1 1.1M11.9 11.9 13 13M3 13l1.1-1.1M11.9 4.1 13 3"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  const root = document.documentElement;

  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try {
      localStorage.setItem('blueprint-theme', next);
    } catch {
      // Private windows may refuse storage; the choice still holds for this page.
    }
    document.dispatchEvent(new CustomEvent('blueprint:theme', { detail: next }));
  });

  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  function setNav(open: boolean) {
    if (open) root.dataset.navOpen = '';
    else delete root.dataset.navOpen;
    toggle?.setAttribute('aria-expanded', String(open));
  }
  toggle?.addEventListener('click', () => setNav(!('navOpen' in root.dataset)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setNav(false);
  });
  document.addEventListener('click', (e) => {
    const target = e.target as Element;
    if ('navOpen' in root.dataset && !target.closest('.sidebar, [data-nav-toggle]')) setNav(false);
  });

  // Copy buttons on highlighted code.
  document.addEventListener('click', async (e) => {
    const button = (e.target as Element).closest<HTMLButtonElement>('[data-copy]');
    const code = button?.closest('figure')?.querySelector('pre');
    if (!button || !code) return;
    try {
      await navigator.clipboard.writeText(code.innerText);
      button.textContent = 'Copied';
      button.dataset.copied = '';
      setTimeout(() => {
        button.textContent = 'Copy';
        delete button.dataset.copied;
      }, 1600);
    } catch {
      button.textContent = 'Select and copy';
    }
  });
</script>
